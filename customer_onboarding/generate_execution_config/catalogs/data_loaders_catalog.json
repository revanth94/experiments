        "end_date": {
          "type": "string",
          "required": true,
          "description": "End date in YYYY-MM-DD format"
        },
        "data_types": {
          "type": "list",
          "required": true,
          "description": "Climate variables to load",
          "valid_values": ["temperature", "humidity", "wind patterns", "precipitation"]
        },
        "output_path": {
          "type": "string",
          "required": true,
          "description": "Path to save loaded data"
        }
      },
      "returns": "Path to loaded data file"
    },
